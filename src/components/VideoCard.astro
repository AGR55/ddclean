---
interface Props {
	title: string;
	subtitle: string;
	src: string;
	poster: string;
}

const { title, subtitle, src, poster } = Astro.props;
---

<article class="video-card">
	<div class="video-frame">
		<video
			src={src}
			poster={poster}
			controls
			playsinline
			preload="metadata"
			aria-label={`${title}: ${subtitle}`}
		></video>
		<div class="overlay"></div>
		<div class="text-overlay">
			<h3>{title}</h3>
			<p>{subtitle}</p>
		</div>
	</div>
</article>

<style>
	.video-card {
		overflow: hidden;
		border-radius: 12px;
		background: var(--navy);
		box-shadow: var(--shadow-sm);
	}

	.video-frame {
		position: relative;
		aspect-ratio: 9 / 16;
		overflow: hidden;
		background: var(--navy);
	}

	.video-frame video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: #000;
		z-index: 0;
	}

	.video-frame video:fullscreen {
		object-fit: contain;
		background: #000;
	}

	.video-frame video:-webkit-full-screen {
		object-fit: contain;
		background: #000;
	}

	.overlay {
		position: absolute;
		inset: 0 0 auto;
		height: 42%;
		z-index: 1;
		background: linear-gradient(
			to bottom,
			rgba(13, 27, 46, 0.74) 0%,
			rgba(13, 27, 46, 0.34) 58%,
			rgba(13, 27, 46, 0) 100%
		);
		pointer-events: none;
	}

	.text-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		padding: clamp(0.8rem, 2.2vw, 1rem);
		z-index: 2;
		pointer-events: none;
	}

	.text-overlay h3 {
		margin: 0 0 0.15rem;
		color: #ffffff !important;
		font-size: clamp(0.88rem, 1.3vw, 1rem);
		font-weight: 800;
		line-height: 1.2;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
	}

	.text-overlay p {
		margin: 0;
		color: rgba(255, 255, 255, 0.85) !important;
		font-size: clamp(0.72rem, 1vw, 0.82rem);
		line-height: 1.3;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
	}

	@media (max-width: 480px) {
		.text-overlay {
			padding: 0.85rem;
		}
	}
</style>
