---
interface Props {
	title: string;
	subtitle: string;
	duration: string;
	index: number;
	productImage: string;
}

const { title, subtitle, duration, index, productImage } = Astro.props;
---

<article class={`video-card video-${index}`}>
	<div class="video-thumb">
		<img src={productImage} alt={title} />
		<div class="overlay"></div>
		<div class="text-overlay">
			<h3>{title}</h3>
			<p>{subtitle}</p>
		</div>
		<button class="play" aria-label={`Reproducir: ${title}`}>
			<svg viewBox="0 0 24 24" fill="none">
				<polygon points="9,6 18,12 9,18" fill="currentColor" stroke="none"/>
			</svg>
		</button>
		<span class="duration">{duration}</span>
	</div>
</article>

<style>
	.video-card {
		overflow: hidden;
		border-radius: 10px;
		background: var(--navy);
		cursor: pointer;
	}

	.video-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.video-thumb img {
		position: absolute;
		width: 240% !important;
		max-width: none !important;
		height: auto;
		top: -5%;
		z-index: 0;
		transition: transform 400ms ease;
	}

	.video-card:hover .video-thumb img {
		transform: scale(1.05);
	}

	.video-0 .video-thumb img {
		left: -18%;
		top: 0%;
	}

	.video-1 .video-thumb img {
		left: -130%;
		top: 0%;
	}

	.video-2 .video-thumb img {
		left: -18%;
		top: -40%;
	}

	.video-3 .video-thumb img {
		left: -130%;
		top: -40%;
	}

	/* Dark gradient from bottom for text legibility */
	.overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			to top,
			rgba(13, 27, 46, 0.88) 0%,
			rgba(13, 27, 46, 0.40) 50%,
			rgba(13, 27, 46, 0.10) 100%
		);
		transition: background 300ms ease;
	}

	.video-card:hover .overlay {
		background: linear-gradient(
			to top,
			rgba(13, 27, 46, 0.92) 0%,
			rgba(13, 27, 46, 0.45) 50%,
			rgba(13, 27, 46, 0.14) 100%
		);
	}

	/* Text positioned inside the thumbnail at the bottom */
	.text-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 0.8rem 1rem;
		z-index: 2;
		pointer-events: none;
	}

	/* Scope under .text-overlay to beat global h3/p color rules */
	.text-overlay h3 {
		margin: 0 0 0.15rem;
		color: #ffffff !important;
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.2;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
	}

	.text-overlay p {
		margin: 0;
		color: rgba(255, 255, 255, 0.85) !important;
		font-size: 0.78rem;
		line-height: 1.3;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
	}

	/* Play button centered */
	.play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		border: none;
		background: rgba(255, 255, 255, 0.92);
		color: var(--blue);
		cursor: pointer;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
		display: grid;
		place-items: center;
		z-index: 3;
		transition: transform 250ms ease, background 200ms ease, box-shadow 250ms ease;
	}

	.play:hover {
		transform: translate(-50%, -50%) scale(1.12);
		background: #fff;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
	}

	.play svg {
		width: 1.15rem;
		height: 1.15rem;
		margin-left: 0.12rem;
		stroke: none;
	}

	/* Duration badge */
	.duration {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		padding: 0.18rem 0.5rem;
		border-radius: 6px;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		color: #fff;
		font-size: 0.7rem;
		font-weight: 800;
		z-index: 3;
	}

	@media (max-width: 480px) {
		.text-overlay h3 {
			font-size: 0.85rem;
		}

		.text-overlay p {
			font-size: 0.72rem;
		}

		.play {
			width: 2.6rem;
			height: 2.6rem;
		}

		.play svg {
			width: 1rem;
			height: 1rem;
		}

		.text-overlay {
			padding: 0.6rem 0.8rem;
		}
	}
</style>
