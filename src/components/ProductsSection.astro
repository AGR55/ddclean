---
import ProductCard from "./ProductCard.astro";

interface Props {
    productImage: string;
    amazonFreshUrl: string;
    amazonEverwhiteUrl: string;
    amazonDishUrl: string;
}

const { productImage, amazonFreshUrl, amazonEverwhiteUrl, amazonDishUrl } =
    Astro.props;
---

<section class="products" id="productos">
    <div class="content container">
        <div class="section-heading">
            <h2>Nuestros productos</h2>
        </div>
        <div class="product-grid">
            <ProductCard
                name="DDC FRESH (blue)"
                subtitle="Pasta concentrado"
                description="Limpieza profunda que ayuda a mantener colores vibrantes y una frescura duradera."
                features={[
                    "Limpieza profunda y efectiva",
                    "Fragancia fresca y duradera",
                    "Ideal para todo tipo de ropa",
                    "Alta concentración, rinde más",
                ]}
                amazonUrl={amazonFreshUrl}
                productImage={`${productImage}/cubo_azul.png`}
                variant="fresh"
            />
            <ProductCard
                name="DD EVERWHITE"
                subtitle="Pasta concentrado"
                description="Formulada para lavar la ropa de personas que no toleran olores fuertes ni fragancias, debido a su neutralidad es la opción ideal para lavar la ropa de los pequeños de casa, las personas con alergia y adultos mayores."
                features={[
                    "Blancos más luminosos",
                    "Remueve manchas difíciles",
                    "Fórmula concentrada",
                    "Protege las fibras y colores",
                ]}
                amazonUrl={amazonEverwhiteUrl}
                productImage={`${productImage}/cubo_blanco.png`}
                variant="white"
            />
            <ProductCard
                name="DDC Dishwashing"
                subtitle="Pasta concentrado"
                description="Pasta concentrada para fregar con alto poder desengrasante y rendimiento superior."
                features={[
                    "Desengrasa platos y utensilios",
                    "Fragancia fresca con toque limón",
                    "Rinde hasta 5 galones",
                    "Fácil de diluir y usar",
                ]}
                amazonUrl={amazonDishUrl}
                productImage={`${productImage}/cubo_verde.png`}
                variant="dish"
            />
        </div>
    </div>
</section>

<style>
    .products {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: clamp(3.25rem, 6vw, 5.5rem) 0;
        background: transparent;
    }

    .products::before,
    .products::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border: 1px solid rgba(255, 255, 255, 0.62);
        background: rgba(255, 255, 255, 0.22);
        filter: blur(0.2px);
        backdrop-filter: blur(18px);
    }

    .products::before {
        width: clamp(14rem, 28vw, 24rem);
        height: clamp(14rem, 28vw, 24rem);
        top: 1rem;
        left: max(-8rem, -7vw);
        border-radius: 42% 58% 61% 39% / 48% 38% 62% 52%;
        box-shadow: inset 24px 24px 48px rgba(255, 255, 255, 0.42);
    }

    .products::after {
        width: clamp(12rem, 24vw, 20rem);
        height: clamp(12rem, 24vw, 20rem);
        right: max(-7rem, -6vw);
        bottom: 2rem;
        border-radius: 58% 42% 44% 56% / 42% 58% 42% 58%;
        box-shadow: inset -20px 22px 46px rgba(255, 255, 255, 0.36);
    }

    .content {
        position: relative;
        margin: 0 auto;
    }

    .section-heading {
        margin-bottom: clamp(2rem, 4vw, 3rem);
    }

    .section-heading h2 {
        color: #164e63;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.78);
    }

    .section-heading h2::after {
        width: 4.25rem;
        height: 0.18rem;
        background: linear-gradient(90deg, var(--cyan), var(--green));
        box-shadow: 0 8px 22px rgba(34, 211, 238, 0.35);
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1rem, 2.2vw, 1.5rem);
        align-items: stretch;
    }

    @media (max-width: 1180px) {
        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 820px) {
        .product-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 720px) {
        .products::before,
        .products::after {
            display: none;
        }
    }
</style>
