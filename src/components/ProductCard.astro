---
import AmazonButton from "./AmazonButton.astro";

interface Props {
    name: string;
    subtitle: string;
    description: string;
    features: string[];
    amazonUrl: string;
    productImage: string;
    variant: "fresh" | "white" | "dish";
    featured?: boolean;
}

const {
    name,
    subtitle,
    description,
    features,
    amazonUrl,
    productImage,
    variant,
    featured = false,
} = Astro.props;
---

<article class:list={["product-card", { featured }, variant]}>
    <div class:list={["product-image", `${variant}-card`]}>
        <img src={productImage} alt={name} />
    </div>
    <div class="product-info">
        <div class="product-copy">
            <h3 class="product-name">{name}</h3>
            <p class="product-description">{description}</p>
            <ul>
                {
                    features.map((f) => (
                        <li>
                            <svg aria-hidden="true" viewBox="0 0 16 16">
                                <path d="M3.2 8.3 6.5 11.6 12.9 4.8" />
                            </svg>
                            <span>{f}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
        <AmazonButton
            href={amazonUrl}
            variant={variant === "white"
                ? "dark"
                : variant === "dish"
                  ? "green"
                  : "primary"}
        />
    </div>
</article>

<style>
    .product-card {
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 1rem;
        align-items: stretch;
        height: 100%;
        padding: clamp(1rem, 2.4vw, 1.4rem);
        border: 1px solid var(--line);
        border-radius: 8px;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.96), #fff),
            radial-gradient(circle at 50% 0%, rgba(30, 136, 229, 0.1), transparent 42%);
        box-shadow: 0 18px 36px rgba(13, 27, 46, 0.06);
        transition:
            border-color 180ms ease,
            box-shadow 180ms ease,
            transform 180ms ease;
    }

    .product-card:hover {
        border-color: rgba(30, 136, 229, 0.28);
        box-shadow: 0 24px 48px rgba(13, 27, 46, 0.1);
        transform: translateY(-3px);
    }

    .product-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 0;
    }

    .product-copy {
        width: 100%;
    }

    .product-card.featured {
        border-color: rgba(30, 136, 229, 0.38);
    }

    .product-image {
        position: relative;
        overflow: hidden;
        height: clamp(11rem, 18vw, 14rem);
        border-radius: 8px;
        background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .product-image img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }

    .product-mark {
        display: grid;
        place-items: center;
        width: 2.65rem;
        height: 2.65rem;
        margin-bottom: 0.65rem;
        color: var(--blue);
    }

    .white .product-mark {
        color: var(--charcoal);
    }

    .dish .product-mark {
        color: var(--green);
    }

    .product-mark svg {
        width: 100%;
        height: 100%;
        stroke-width: 1.7;
    }

    .product-name {
        color: var(--blue);
    }

    .white .product-name {
        color: var(--charcoal);
    }

    .white.product-card {
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.98), #fff),
            radial-gradient(circle at 50% 0%, rgba(51, 51, 51, 0.08), transparent 43%);
    }

    .dish .product-name {
        color: #3d9821;
    }

    .dish.product-card {
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.97), #fff),
            radial-gradient(circle at 50% 0%, rgba(98, 200, 55, 0.12), transparent 43%);
    }

    .product-kicker {
        margin: 0 0 0.55rem;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    h3 {
        margin-bottom: 0.35rem;
        color: var(--navy);
        font-size: clamp(1.2rem, 2vw, 1.5rem);
        font-weight: 900;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .product-description {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.45;
        min-height: 7.65rem;
    }

    ul {
        display: grid;
        gap: 0.55rem;
        margin: 1rem 0 1.25rem;
        padding: 0;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 600;
        color: #28364b;
    }

    .product-info :global(.amazon-btn) {
        width: 100%;
        margin-top: auto;
    }

    li {
        display: grid;
        grid-template-columns: 1.05rem 1fr;
        align-items: start;
        gap: 0.55rem;
        line-height: 1.35;
    }

    li svg {
        width: 1.05rem;
        height: 1.05rem;
        margin-top: 0.08rem;
        padding: 0.12rem;
        border-radius: 50%;
        background: var(--blue);
        color: #fff;
        stroke: currentColor;
        stroke-width: 2.3;
        fill: none;
    }

    .white li svg {
        background: var(--charcoal);
    }

    .dish li svg {
        background: var(--green);
    }

    @media (max-width: 720px) {
        .product-card {
            grid-template-columns: 1fr;
        }

        .product-image {
            width: 100%;
            height: 13rem;
        }
    }

    @media (max-width: 480px) {
        .product-card {
            padding: 0.8rem;
        }

        .product-image {
            height: 10rem;
        }

        .product-mark {
            width: 2.2rem;
            height: 2.2rem;
            margin-bottom: 0.4rem;
        }

        h3 {
            font-size: 1.1rem;
        }

        .product-description {
            font-size: 0.82rem;
            min-height: auto;
        }

        ul {
            font-size: 0.82rem;
            gap: 0.4rem;
            margin: 0.8rem 0 1rem;
        }
    }
</style>
