---
import AmazonButton from "./AmazonButton.astro";

interface Props {
    name: string;
    subtitle: string;
    description: string;
    features: string[];
    amazonUrl: string;
    productImage: string;
    variant: "fresh" | "white" | "dish";
    featured?: boolean;
}

const {
    name,
    subtitle,
    description,
    features,
    amazonUrl,
    productImage,
    variant,
    featured = false,
} = Astro.props;
---

<article class:list={["product-card", { featured }, variant]}>
    <div class:list={["product-image", `${variant}-card`]}>
        <img src={productImage} alt={name} />
    </div>
    <div class="product-info">
        <div class="product-copy">
            <h3 class="product-name">{name}</h3>
            <p class="product-description">{description}</p>
            <ul>
                {
                    features.map((f) => (
                        <li>
                            <svg aria-hidden="true" viewBox="0 0 16 16">
                                <path d="M3.2 8.3 6.5 11.6 12.9 4.8" />
                            </svg>
                            <span>{f}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
        <AmazonButton
            href={amazonUrl}
            variant={variant === "white"
                ? "dark"
                : variant === "dish"
                  ? "green"
                  : "primary"}
        />
    </div>
</article>

<style>
    .product-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 1.1rem;
        align-items: stretch;
        height: 100%;
        padding: clamp(1rem, 2.4vw, 1.4rem);
        border: 1px solid rgba(255, 255, 255, 0.62);
        border-radius: 8px;
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.38)),
            radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.26), transparent 14rem),
            radial-gradient(circle at 85% 18%, rgba(30, 136, 229, 0.14), transparent 13rem);
        box-shadow: var(--glass-shadow);
        backdrop-filter: blur(22px) saturate(1.28);
        -webkit-backdrop-filter: blur(22px) saturate(1.28);
        transition:
            border-color 180ms ease,
            box-shadow 180ms ease,
            transform 180ms ease;
    }

    .product-card::before {
        content: "";
        position: absolute;
        inset: 1px;
        z-index: -1;
        border-radius: 7px;
        background:
            linear-gradient(120deg, rgba(255, 255, 255, 0.78), transparent 34%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.06));
        pointer-events: none;
    }

    .product-card::after {
        content: "";
        position: absolute;
        width: 8.5rem;
        height: 8.5rem;
        right: -3.25rem;
        top: -3.8rem;
        z-index: -1;
        border-radius: 46% 54% 58% 42% / 48% 42% 58% 52%;
        background: rgba(255, 255, 255, 0.34);
        box-shadow: inset 16px 18px 34px rgba(255, 255, 255, 0.32);
        pointer-events: none;
    }

    .product-card:hover {
        border-color: rgba(34, 211, 238, 0.56);
        box-shadow: 0 28px 66px rgba(13, 27, 46, 0.16);
        transform: translateY(-4px);
    }

    .product-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 0;
    }

    .product-copy {
        width: 100%;
    }

    .product-card.featured {
        border-color: rgba(34, 211, 238, 0.74);
        box-shadow: 0 28px 68px rgba(8, 145, 178, 0.18);
    }

    .product-image {
        position: relative;
        overflow: hidden;
        height: clamp(11rem, 18vw, 14rem);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.68);
        background:
            radial-gradient(circle at 50% 25%, rgba(255, 255, 255, 0.92), transparent 9rem),
            linear-gradient(145deg, rgba(255, 255, 255, 0.58), rgba(236, 254, 255, 0.42));
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.76),
            inset 0 -18px 42px rgba(8, 145, 178, 0.08);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .product-image::before {
        content: "";
        position: absolute;
        inset: 0.65rem 0.8rem auto;
        height: 35%;
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.62), transparent);
        pointer-events: none;
    }

    .product-image img {
        position: absolute;
        inset: 0.8rem;
        width: calc(100% - 1.6rem);
        height: calc(100% - 1.6rem);
        object-fit: contain;
        object-position: center;
        filter: drop-shadow(0 20px 24px rgba(13, 27, 46, 0.12));
        transition: transform 220ms ease;
    }

    .product-card:hover .product-image img {
        transform: translateY(-3px) scale(1.025);
    }

    .product-mark {
        display: grid;
        place-items: center;
        width: 2.65rem;
        height: 2.65rem;
        margin-bottom: 0.65rem;
        color: var(--blue);
    }

    .white .product-mark {
        color: var(--charcoal);
    }

    .dish .product-mark {
        color: var(--green);
    }

    .product-mark svg {
        width: 100%;
        height: 100%;
        stroke-width: 1.7;
    }

    .product-name {
        color: var(--blue);
        text-wrap: balance;
    }

    .white .product-name {
        color: #164e63;
    }

    .white.product-card {
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.45)),
            radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.58), transparent 13rem),
            radial-gradient(circle at 82% 16%, rgba(8, 145, 178, 0.12), transparent 12rem);
    }

    .dish .product-name {
        color: #2f7f1d;
    }

    .dish.product-card {
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.38)),
            radial-gradient(circle at 18% 0%, rgba(98, 200, 55, 0.22), transparent 14rem),
            radial-gradient(circle at 85% 18%, rgba(34, 211, 238, 0.14), transparent 13rem);
    }

    .product-kicker {
        margin: 0 0 0.55rem;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    h3 {
        margin-bottom: 0.35rem;
        color: var(--navy);
        font-size: clamp(1.2rem, 2vw, 1.5rem);
        font-weight: 900;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .product-description {
        margin: 0;
        color: #40515f;
        font-size: 0.88rem;
        line-height: 1.5;
        min-height: 7.65rem;
    }

    ul {
        display: grid;
        gap: 0.55rem;
        margin: 1rem 0 1.25rem;
        padding: 0;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 600;
        color: #24384a;
    }

    .product-info :global(.amazon-btn) {
        width: 100%;
        margin-top: auto;
    }

    li {
        display: grid;
        grid-template-columns: 1.05rem 1fr;
        align-items: start;
        gap: 0.55rem;
        line-height: 1.35;
    }

    li svg {
        width: 1.05rem;
        height: 1.05rem;
        margin-top: 0.08rem;
        padding: 0.12rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--cyan), var(--blue));
        color: #fff;
        stroke: currentColor;
        stroke-width: 2.3;
        fill: none;
        box-shadow: 0 6px 14px rgba(8, 145, 178, 0.2);
    }

    .white li svg {
        background: linear-gradient(135deg, #164e63, #64748b);
    }

    .dish li svg {
        background: linear-gradient(135deg, var(--green), #22c55e);
    }

    @media (prefers-reduced-motion: reduce) {
        .product-card,
        .product-image img {
            transition: none;
        }

        .product-card:hover,
        .product-card:hover .product-image img {
            transform: none;
        }
    }

    @media (max-width: 720px) {
        .product-card {
            grid-template-columns: 1fr;
        }

        .product-image {
            width: 100%;
            height: 13rem;
        }
    }

    @media (max-width: 480px) {
        .product-card {
            padding: 0.8rem;
        }

        .product-image {
            height: 10rem;
        }

        .product-mark {
            width: 2.2rem;
            height: 2.2rem;
            margin-bottom: 0.4rem;
        }

        h3 {
            font-size: 1.1rem;
        }

        .product-description {
            font-size: 0.82rem;
            min-height: auto;
        }

        ul {
            font-size: 0.82rem;
            gap: 0.4rem;
            margin: 0.8rem 0 1rem;
        }
    }
</style>
