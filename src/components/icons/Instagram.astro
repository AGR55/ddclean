---
interface Props {
    size?: number | string;
    color?: string;
    strokeWidth?: number | string;
    title?: string;
}

const {
    size = 20,
    color = "currentColor",
    strokeWidth = 1.9,
    title,
} = Astro.props;

const iconSize = typeof size === "number" ? `${size}px` : size;
---

<svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    role={title ? "img" : undefined}
    aria-hidden={title ? undefined : "true"}
    aria-label={title}
    style={`width: ${iconSize}; height: ${iconSize}; color: ${color}; display: block; fill: none; stroke: currentColor; stroke-width: ${strokeWidth}; stroke-linecap: round; stroke-linejoin: round;`}
>
    {title && <title>{title}</title>}
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4.35" />
    <circle cx="17.15" cy="6.85" r="1.05" fill="currentColor" stroke="none" />
</svg>
