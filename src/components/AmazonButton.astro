---
interface Props {
	href: string;
	variant?: 'primary' | 'dark' | 'green' | 'outline' | 'footer';
	class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const classes = ['amazon-btn', variant !== 'primary' ? variant : '', className].filter(Boolean).join(' ');
---

<a class={classes} href={href} target="_blank" rel="noopener noreferrer">
	<span class="amazon-icon" aria-hidden="true">
		<img src="/icons/amazon.svg" alt="" loading="lazy" />
	</span>
	<slot>Comprar en Amazon</slot>
</a>

<style>
	.amazon-btn {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 3rem;
		padding: 0.8rem 1.6rem;
		border-radius: 8px;
		font-weight: 800;
		font-size: 0.95rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.2), transparent 34%),
			linear-gradient(135deg, var(--cyan), var(--blue));
		color: #fff;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.34),
			0 14px 30px rgba(8, 145, 178, 0.24);
		transition:
			box-shadow 180ms ease,
			filter 180ms ease,
			transform 180ms ease;
		cursor: pointer;
		border: none;
		text-decoration: none;
		white-space: nowrap;
	}

	.amazon-btn::before {
		content: "";
		position: absolute;
		inset: 1px;
		z-index: -1;
		border-radius: 7px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent 52%);
		pointer-events: none;
	}

	.amazon-btn:hover {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.42),
			0 18px 34px rgba(8, 145, 178, 0.3);
		filter: saturate(1.08);
		transform: translateY(-1px);
	}

	.amazon-btn:active {
		transform: translateY(0);
	}

	.amazon-icon {
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 50%;
		background: #fff;
		box-shadow: inset 0 -3px 7px rgba(13, 27, 46, 0.08);
		flex-shrink: 0;
	}

	.amazon-icon img {
		width: 1.1rem;
		height: 1.1rem;
		object-fit: contain;
	}

	/* Dark variant */
	.dark {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.2), transparent 34%),
			linear-gradient(135deg, #164e63, var(--charcoal));
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.25),
			0 14px 30px rgba(22, 78, 99, 0.22);
	}

	.green {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.22), transparent 34%),
			linear-gradient(135deg, #22c55e, var(--green));
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.34),
			0 14px 30px rgba(34, 197, 94, 0.24);
	}

	.green:hover {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.42),
			0 18px 34px rgba(34, 197, 94, 0.3);
	}

	/* Outline variant */
	.outline {
		background: rgba(255, 255, 255, 0.85);
		color: var(--blue, #1e88e5);
		border: 1px solid rgba(30, 136, 229, 0.34);
		box-shadow: 0 12px 24px rgba(13, 27, 46, 0.08);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.outline:hover {
		background: rgba(30, 136, 229, 0.06);
	}

	.outline .amazon-icon {
		background: var(--blue, #1e88e5);
	}

	/* Footer variant */
	.footer {
		border: 1px solid rgba(255, 255, 255, 0.4);
	}

	@media (prefers-reduced-motion: reduce) {
		.amazon-btn {
			transition: none;
		}

		.amazon-btn:hover,
		.amazon-btn:active {
			transform: none;
		}
	}
</style>
