---
interface Props {
	href: string;
	variant?: 'primary' | 'dark' | 'green' | 'outline' | 'footer';
	class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const classes = ['amazon-btn', variant !== 'primary' ? variant : '', className].filter(Boolean).join(' ');
---

<a class={classes} href={href} target="_blank" rel="noopener noreferrer">
	<span class="amazon-icon" aria-hidden="true">
		<img src="/icons/amazon.svg" alt="" loading="lazy" />
	</span>
	<slot>Comprar en Amazon</slot>
</a>

<style>
	.amazon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 3rem;
		padding: 0.8rem 1.6rem;
		border-radius: 8px;
		font-weight: 800;
		font-size: 0.95rem;
		background: var(--blue);
		color: #fff;
		transition: background 180ms ease, transform 180ms ease;
		cursor: pointer;
		border: none;
		text-decoration: none;
		white-space: nowrap;
	}

	.amazon-btn:hover {
		opacity: 90%;
	}

	.amazon-btn:active {
		opacity: 100%;
	}

	.amazon-icon {
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 50%;
		background: #fff;
		flex-shrink: 0;
	}

	.amazon-icon img {
		width: 1.1rem;
		height: 1.1rem;
		object-fit: contain;
	}

	/* Dark variant */
	.dark {
		background: var(--charcoal);
	}

	.green {
		background: var(--green);
	}

	.green:hover {
		background: #55b82e;
	}

	/* Outline variant */
	.outline {
		background: rgba(255, 255, 255, 0.85);
		color: var(--blue, #1e88e5);
		border: 2px solid var(--blue, #1e88e5);
		box-shadow: none;
	}

	.outline:hover {
		background: rgba(30, 136, 229, 0.06);
	}

	.outline .amazon-icon {
		background: var(--blue, #1e88e5);
	}

	/* Footer variant */
	.footer {
		border: 1px solid rgba(255, 255, 255, 0.4);
	}
</style>
