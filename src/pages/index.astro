---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BenefitStrip from "../components/BenefitStrip.astro";
import ProductsSection from "../components/ProductsSection.astro";
import VideosSection from "../components/VideosSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const amazonFreshUrl = "https://amzn.to/4uk69ZR";
const amazonEverwhiteUrl = "https://amzn.to/3PkKrpe";
const amazonDishUrl = "https://amzn.to/3PHvT3f";
const amazonMainUrl = amazonFreshUrl;
const productSheet = "/landing-assets";
const mainImage = "/landing-assets/main_banner.png";
const mobileMainImage = "/landing-assets/mobile_main_banner.png";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content="DDC Detergentes: pastas concentradas de alto rendimiento para ropa más limpia, fresca y luminosa. Compra DDC Fresh, DD Everwhite y DDC Dishwashing en Amazon."
        />
        <meta name="generator" content={Astro.generator} />
        <title>DDC Detergentes Concentrados | Compra en Amazon</title>
    </head>
    <body>
        <Header amazonUrl={amazonMainUrl} />

        <main>
            <Hero
                amazonUrl={amazonMainUrl}
                productImage={productSheet}
                mainImage={mainImage}
                mobileMainImage={mobileMainImage}
            />
            <BenefitStrip />
            <ProductsSection
                productImage={productSheet}
                amazonFreshUrl={amazonFreshUrl}
                amazonEverwhiteUrl={amazonEverwhiteUrl}
                amazonDishUrl={amazonDishUrl}
            />
            <VideosSection />
            <TestimonialsSection />
            <FaqSection />
        </main>

        <Footer amazonUrl={amazonMainUrl} />

        <script>
            import { gsap } from "gsap";
            import { ScrollToPlugin } from "gsap/ScrollToPlugin";

            gsap.registerPlugin(ScrollToPlugin);

            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            document
                .querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
                .forEach((anchor) => {
                    anchor.addEventListener("click", (event) => {
                        const hash = anchor.getAttribute("href");
                        if (!hash || hash === "#") return;

                        const target = document.querySelector(hash);
                        if (!target) return;

                        event.preventDefault();

                        if (reduceMotion) {
                            target.scrollIntoView();
                            history.pushState(null, "", hash);
                            return;
                        }

                        gsap.to(window, {
                            duration: 0.95,
                            scrollTo: {
                                y: target,
                                offsetY: 88,
                            },
                            ease: "power3.inOut",
                            onComplete: () => history.pushState(null, "", hash),
                        });
                    });
                });
        </script>
    </body>
</html>
