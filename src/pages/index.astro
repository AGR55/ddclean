---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BenefitStrip from "../components/BenefitStrip.astro";
import ProductsSection from "../components/ProductsSection.astro";
import VideosSection from "../components/VideosSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const amazonFreshUrl = "https://amzn.to/4uk69ZR";
const amazonEverwhiteUrl = "https://amzn.to/3PkKrpe";
const amazonDishUrl = "https://amzn.to/3PHvT3f";
const amazonMainUrl = amazonFreshUrl;
const productSheet = "/landing-assets";
const mainImage = "/landing-assets/main_banner.png";
const mobileMainImage = "/landing-assets/mobile_main_banner.png";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content="DDC Detergentes: pastas concentradas de alto rendimiento para ropa más limpia, fresca y luminosa. Compra DDC Fresh, DD Everwhite y DDC Dishwashing en Amazon."
        />
        <meta name="generator" content={Astro.generator} />
        <title>DDC Detergentes Concentrados | Compra en Amazon</title>
    </head>
    <body>
        <Header amazonUrl={amazonMainUrl} />

        <main>
            <Hero
                amazonUrl={amazonMainUrl}
                productImage={productSheet}
                mainImage={mainImage}
                mobileMainImage={mobileMainImage}
            />
            <div class="liquid-flow">
                <BenefitStrip />
                <ProductsSection
                    productImage={productSheet}
                    amazonFreshUrl={amazonFreshUrl}
                    amazonEverwhiteUrl={amazonEverwhiteUrl}
                    amazonDishUrl={amazonDishUrl}
                />
                <VideosSection />
                <TestimonialsSection />
                <FaqSection />
            </div>
        </main>

        <Footer amazonUrl={amazonMainUrl} />

        <script>
            const navLinks = Array.from(
                document.querySelectorAll<HTMLAnchorElement>(
                    '.site-header nav a[href^="#"]',
                ),
            );
            const sections = navLinks
                .map((link) => {
                    const id = link.hash.slice(1);
                    const section = document.getElementById(id);
                    return section ? { id, link, section } : null;
                })
                .filter((item): item is {
                    id: string;
                    link: HTMLAnchorElement;
                    section: HTMLElement;
                } => item !== null);

            const setActiveSection = (activeId: string) => {
                sections.forEach(({ id, link }) => {
                    link.classList.toggle("active", id === activeId);
                });
            };

            const getSectionTop = (section: HTMLElement) =>
                section.getBoundingClientRect().top + window.scrollY;

            const getOrderedSections = () =>
                [...sections].sort(
                    (a, b) => getSectionTop(a.section) - getSectionTop(b.section),
                );

            const updateActiveSection = () => {
                const scrollY = window.scrollY;
                const orderedSections = getOrderedSections();
                const pageBottom =
                    window.innerHeight + scrollY >=
                    document.documentElement.scrollHeight - 24;

                if (pageBottom) {
                    const lastSection = orderedSections.at(-1);
                    if (lastSection) setActiveSection(lastSection.id);
                    return;
                }

                const marker = scrollY + window.innerHeight * 0.34;
                const current =
                    orderedSections.reduce((active, item) => {
                        const top = getSectionTop(item.section);
                        return top <= marker ? item : active;
                    }, orderedSections[0]) ?? orderedSections[0];

                if (current) setActiveSection(current.id);
            };

            navLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    const id = link.hash.slice(1);
                    if (id) setActiveSection(id);
                });
            });

            updateActiveSection();
            let ticking = false;
            window.addEventListener(
                "scroll",
                () => {
                    if (ticking) return;
                    ticking = true;
                    window.requestAnimationFrame(() => {
                        updateActiveSection();
                        ticking = false;
                    });
                },
                { passive: true },
            );
            window.addEventListener("resize", updateActiveSection);
        </script>
    </body>
</html>

<style>
    .liquid-flow {
        position: relative;
        z-index: 2;
        isolation: isolate;
        overflow: visible;
        margin-top: -2rem;
        padding-top: 2rem;
        padding-bottom: clamp(1.5rem, 4vw, 3rem);
        background:
            radial-gradient(circle at 12% 8%, rgba(34, 211, 238, 0.32), transparent 30rem),
            radial-gradient(circle at 92% 24%, rgba(98, 200, 55, 0.18), transparent 28rem),
            radial-gradient(circle at 18% 64%, rgba(30, 136, 229, 0.16), transparent 30rem),
            linear-gradient(180deg, #ffffff 0%, #ecfeff 11%, #f8fafc 47%, #eefcff 78%, #ecfeff 100%);
    }

    .liquid-flow::before,
    .liquid-flow::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border: 1px solid rgba(255, 255, 255, 0.56);
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .liquid-flow::before {
        width: clamp(14rem, 26vw, 26rem);
        height: clamp(14rem, 26vw, 26rem);
        top: 8rem;
        left: max(-9rem, -7vw);
        border-radius: 42% 58% 61% 39% / 48% 38% 62% 52%;
        box-shadow: inset 24px 24px 48px rgba(255, 255, 255, 0.4);
    }

    .liquid-flow::after {
        width: clamp(15rem, 28vw, 28rem);
        height: clamp(15rem, 28vw, 28rem);
        right: max(-10rem, -7vw);
        bottom: 8rem;
        border-radius: 58% 42% 44% 56% / 42% 58% 42% 58%;
        box-shadow: inset -22px 24px 50px rgba(255, 255, 255, 0.36);
    }
</style>
